# Konfiguracja OpenProject na QNAP. Skopiuj do .env i uzupelnij: cp .env.example .env
# Plik .env zawiera sekrety i jest w .gitignore - nigdy go nie commituj.

# --- Wersja obrazu OpenProject -------------------------------------------
# Tag obrazu openproject/openproject (17-slim = stabilna linia 17.x).
OP_IMAGE_TAG=17-slim

# --- Sciezki na NAS-ie ----------------------------------------------------
# Dane (pgdata, assets, tailscale) - katalogi tworzone przy pierwszym starcie.
OP_DATA_DIR=/share/Container/openproject
# Nocne kopie zapasowe.
OP_BACKUP_DIR=/share/Backup/openproject

# --- Adresy ---------------------------------------------------------------
# Publiczna nazwa hosta (Cloudflare Tunnel), np. projekty.example.com.
OP_PUBLIC_HOST=projekty.example.com
# Nazwa hosta w sieci Tailscale, np. openproject.tailnet-name.ts.net.
OP_TAILSCALE_HOST=openproject.tailnet-name.ts.net
# Lokalny port (tylko 127.0.0.1, profil "local"). Nie 8080 - zajmuje go panel QTS.
OP_LOCAL_PORT=8081

# --- Sekrety (ZMIEN przed pierwszym uruchomieniem) ------------------------
# Haslo bazy danych. Uzyj znakow hex, bo trafia do adresu URL: openssl rand -hex 24
OP_DB_PASSWORD=change-me-db-password
# Klucz sesji Rails. Wygeneruj poleceniem: openssl rand -hex 64
OP_SECRET_KEY_BASE=change-me-run-openssl-rand-hex-64
# Haslo konta administratora (login: admin), ustawiane tylko przy pierwszym starcie.
OP_ADMIN_PASSWORD=change-me-admin-password
# Token Cloudflare Tunnel (profil "public").
CLOUDFLARE_TUNNEL_TOKEN=change-me-cloudflare-tunnel-token
# Klucz uwierzytelniajacy Tailscale (profil "tailnet"), najlepiej wielokrotnego uzytku.
TS_AUTHKEY=change-me-tailscale-authkey

# --- Kopie zapasowe -------------------------------------------------------
# Godzina nocnej kopii (GG:MM) w strefie czasowej TZ.
BACKUP_TIME=03:15
# Ile dni przechowywac kopie.
BACKUP_RETENTION_DAYS=14
# Strefa czasowa kontenera kopii zapasowych.
TZ=Europe/Warsaw

# --- Profil pamieci: 4 GB RAM (aktywny) -----------------------------------
# Limity pamieci kontenerow.
OP_DB_MEM=512m
OP_CACHE_MEM=64m
OP_CACHE_MB=48
OP_WEB_MEM=1200m
OP_WORKER_MEM=1g
# Liczba procesow Puma (0 = tryb pojedynczy, najmniej pamieci).
OP_WEB_WORKERS=0
# Liczba watkow zadan w tle.
OP_GOOD_JOB_MAX_THREADS=3

# --- Profil pamieci: 8 GB RAM (odkomentuj, a profil 4 GB zakomentuj) -------
# OP_DB_MEM=1g
# OP_CACHE_MEM=128m
# OP_CACHE_MB=96
# OP_WEB_MEM=2g
# OP_WORKER_MEM=1280m
# OP_WEB_WORKERS=1
# OP_GOOD_JOB_MAX_THREADS=5

# --- Profil pamieci: 16 GB RAM (odkomentuj, a profil 4 GB zakomentuj) ------
# OP_DB_MEM=2g
# OP_CACHE_MEM=256m
# OP_CACHE_MB=192
# OP_WEB_MEM=3g
# OP_WORKER_MEM=1536m
# OP_WEB_WORKERS=2
# OP_GOOD_JOB_MAX_THREADS=10
